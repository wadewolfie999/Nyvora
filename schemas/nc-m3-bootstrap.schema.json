{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodecontrol.local/schemas/nc-m3-bootstrap.schema.json",
  "title": "NC-M3Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "nodecontrol.io/v1alpha1"},
    "kind": {"const": "NC-M3Bootstrap"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"const": "primary"}}
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement_profile", "operator", "age_recipients", "preconditions", "records"],
      "properties": {
        "placement_profile": {"const": "mac-authority"},
        "base_domain": {"type": "string", "minLength": 4, "maxLength": 253},
        "operator": {"const": "vahid"},
        "age_recipients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^age1[0-9a-z]+$"}
        },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mac_authority_and_recovery_procedure_approved", "authenticated_private_three_node_control_path_designed", "asus_postgres_and_nats_placement_approved", "vps_private_topology_membership_designed"],
          "properties": {
            "mac_authority_and_recovery_procedure_approved": {"const": true},
            "authenticated_private_three_node_control_path_designed": {"const": true},
            "asus_postgres_and_nats_placement_approved": {"const": true},
            "vps_private_topology_membership_designed": {"const": true},
            "wildcard_dns_control": {"type": "boolean"},
            "public_tls_and_ingress_control": {"type": "boolean"},
            "authentik_human_identity_bootstrap": {"type": "boolean"},
            "vps_provider_console_recovery": {"const": true},
            "vps_firewall_control": {"const": true},
            "asus_interactive_sudo": {"const": true},
            "asus_no_critical_simulation": {"const": true},
            "age_offline_recovery_copy": {"const": true},
            "asus_42665_owner_resolved": {"const": true},
            "nats_credentials_generated": {"const": true}
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_placement_evidence", "private_topology_evidence", "dns_evidence", "recovery_evidence", "capacity_evidence", "privilege_evidence", "port_ownership_evidence", "caddy_preservation_evidence", "secret_custody_evidence", "nats_evidence"],
          "properties": {
            "authority_placement_evidence": {"type": "string", "minLength": 1},
            "private_topology_evidence": {"type": "string", "minLength": 1},
            "dns_evidence": {"type": "string", "minLength": 1},
            "recovery_evidence": {"type": "string", "minLength": 1},
            "capacity_evidence": {"type": "string", "minLength": 1},
            "privilege_evidence": {"type": "string", "minLength": 1},
            "port_ownership_evidence": {"type": "string", "minLength": 1},
            "caddy_preservation_evidence": {"type": "string", "minLength": 1},
            "secret_custody_evidence": {"type": "string", "minLength": 1},
            "nats_evidence": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
