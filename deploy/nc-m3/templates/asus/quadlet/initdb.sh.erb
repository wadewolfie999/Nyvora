#!/bin/sh
set -eu

for credential in nodecontrol-db-password authentik-db-password; do
  test -s "/run/secrets/${credential}"
done

psql --set=ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<'SQL'
\set nodecontrol_password `cat /run/secrets/nodecontrol-db-password`
\set authentik_password `cat /run/secrets/authentik-db-password`

SELECT format('CREATE ROLE nodecontrol LOGIN PASSWORD %L', :'nodecontrol_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'nodecontrol')
\gexec

SELECT format('CREATE ROLE authentik LOGIN PASSWORD %L', :'authentik_password')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'authentik')
\gexec

SELECT 'CREATE DATABASE nodecontrol OWNER nodecontrol'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'nodecontrol')
\gexec

SELECT 'CREATE DATABASE authentik OWNER authentik'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'authentik')
\gexec
SQL
